# ==============================================
# VPN DUCK PROJECT - TELEGRAM CONFIGURATION
# ==============================================

# -----------------------------
# TELEGRAM BOT ТОКЕНЫ
# -----------------------------
# Основной токен бота (получить у @BotFather)
TELEGRAM_TOKEN=your_telegram_bot_token_here

# Токен провайдера платежей для Telegram Stars
# Получить у @BotFather через /mybots -> Bot Settings -> Payments
PAYMENT_TOKEN=your_telegram_payment_provider_token_here

# -----------------------------
# TELEGRAM STARS ТАРИФЫ
# -----------------------------
# Стоимость в звездах Telegram
STARS_RATES_1_DAY=10
STARS_RATES_7_DAYS=50
STARS_RATES_30_DAYS=150

# -----------------------------
# ОСТАЛЬНЫЕ ПЕРЕМЕННЫЕ (из вашего проекта)
# -----------------------------
# Административные
ADMIN_SECRET_KEY=fvcfq9d3ycefnvmftiaso
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# База данных
POSTGRES_HOST=db
POSTGRES_DB=wireguard
POSTGRES_USER=postgres
POSTGRES_PASSWORD=5YE2w8bxd9
KONG_DB_PASSWORD=kong_pass

# URL сервисов
DATABASE_SERVICE_URL=http://database-service:5002
WIREGUARD_SERVICE_URL=http://wireguard-proxy:5001
METRICS_SERVICE_URL=http://metrics-collector:5003
API_GATEWAY_URL=http://kong:8000

# Режимы работы
USE_MOCK_DATA=false
FALLBACK_MODE_ENABLED=true
DEBUG=false
REMOTE_ONLY=true

# Кэширование
CACHE_DEFAULT_TTL=300
CACHE_SERVERS_TTL=300
CACHE_GEOLOCATIONS_TTL=300
CACHE_METRICS_TTL=60

# Маршрутизация
LOAD_BALANCE_STRATEGY=least_loaded
GEOLOCATION_PRIORITY=true
FALLBACK_ENABLED=true
MAX_RETRY_ATTEMPTS=3

# Database Client
DB_CLIENT_TIMEOUT=10
DB_CLIENT_MAX_RETRIES=3
DB_CLIENT_RETRY_BACKOFF=exponential

# Миграция
CHECK_INTERVAL=300
MIGRATION_THRESHOLD=3
PACKET_LOSS_THRESHOLD=50.0
LATENCY_THRESHOLD=300.0
